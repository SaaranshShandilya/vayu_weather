# Add real values only in your local .env or the Hugging Face Space secrets.
# A .env in the project root is loaded at startup; real environment
# variables always win over it.
#
# GEMINI_API_KEYS takes one or more keys, separated by commas or newlines.
# Free-tier quota is metered per Google Cloud project, not per key, so keys
# only add capacity when each comes from a separate project. Prove it with:
#   python scripts/check_keys.py --burst 40
GEMINI_API_KEYS=
# Single-key alias, still supported.
GEMINI_API_KEY=
APP_PASSWORD=

# Optional. The default is the stable Gemini model used by the app.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional key-pool tuning. GEMINI_RPM_PER_KEY and GEMINI_KEY_WAIT_S are
# accepted as aliases for the first two.
#
# Per-key pacing. 0 disables it: the pool then reacts to real 429s instead
# of guessing. Set it just below the limit your project actually reports
# (the 429 message names it, e.g. `limit: 15`). Measured on this app:
# pacing at 20 against a real limit of 15 cost 17 rate limits per 100
# calls; pacing at 12 cost 2.
GEMINI_KEY_RPM=12
GEMINI_KEY_RPD=0
# Longest one call waits for a key with headroom.
GEMINI_KEY_WAIT_SECONDS=40
# Wall-clock budget for all of one turn's calls, so waits cannot stack.
# Defaults to the lease wait plus 20s.
GEMINI_TURN_BUDGET_SECONDS=60
# Concurrent /api/chat turns. 0 means no cap. API_THREAD_LIMIT is an alias.
API_CONCURRENCY_LIMIT=96
